AOS8_BASE_URL=https://your-mobility-conductor:4343
AOS8_USERNAME=admin
AOS8_PASSWORD=change-me
AOS8_VERIFY_SSL=true
AOS8_CA_BUNDLE=
AOS8_REQUEST_TIMEOUT=30
AOS8_RETRY_ATTEMPTS=3
AOS8_RETRY_BACKOFF_SECONDS=0.5
# JSON mapping for direct managed-device API endpoints. Keep credentials out of source control.
